# ==============================================================================
# MULTIMEDIA EDITOR HYBRID — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env untuk menjalankan backend dengan provider nyata.
# JANGAN PERNAH MENYIMPAN KUNCI RAHASIA (SECRETS) KE DALAM FILE INI ATAU GIT!
# ==============================================================================

# Server Network Settings
PORT=3001
HOST=127.0.0.1

# AI Generative Provider Selection ('huggingface' | 'replicate')
AI_PROVIDER=huggingface

# Hugging Face User Access Token (Dapatkan di https://huggingface.co/settings/tokens)
# Biarkan kosong jika ingin menjalankan backend dalam mode 'PROVIDER_NOT_CONFIGURED'.
AI_PROVIDER_API_KEY=

# Default Generative Model untuk Background Removal
# Menggunakan router modern Hugging Face: https://router.huggingface.co/hf-inference/models/briaai/RMBG-1.4
AI_PROVIDER_MODEL=briaai/RMBG-1.4

# Security Guardrails & Limits
# 10 MB Maksimum Payload (10 * 1024 * 1024 bytes)
MAX_PAYLOAD_SIZE_BYTES=10485760

# Rate Limiter (Maksimum permintaan per menit per alamat IP)
RATE_LIMIT_MAX_PER_MINUTE=10

# Request Timeout (30 detik)
REQUEST_TIMEOUT_MS=30000

# Concurrency Limit (Maksimum proses inferensi simultan)
MAX_CONCURRENT_REQUESTS=2
